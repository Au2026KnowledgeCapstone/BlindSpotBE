# Direct Postgres connection (required). Port 5432. Alembic and anything
# taking a Postgres advisory lock must use this one — advisory locks are
# session-scoped and a transaction-mode pooler can lose them.
DATABASE_URL=

# Pooled Postgres connection (optional). Port 6543. Request handlers only.
DATABASE_POOLED_URL=

# aiservice base URL. Configured now, unused until B3.
AI_SERVICE_URL=

# Persistent Fernet key for environment credentials. Optional until credentials
# are written; blank disables credential writes. Share across workers; do not rotate
# without decrypting and re-encrypting stored values.


## THIS IS GENERATED LOCALLY, REMEMBER THIS KEY IS NOT IN VERSION CONTROL. VALUES.
ENVIRONMENT_CREDENTIAL_ENCRYPTION_KEY=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Auth (backend-owned Supabase sessions; see app/core/auth*.py) ---
# No dev bypass exists — local dev needs a real Supabase project and a real
# login through /auth/login, the same as production.

# Existing project's HTTPS URL and publishable key. No service-role key needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# development enables http://localhost origins and relaxes cookie flags;
# anything else is treated as production (HTTPS-only origins, Secure cookies).
APP_ENV=development

# Comma-separated frontend origins allowed to call /auth/* with credentials.
AUTH_FRONTEND_ORIGINS=http://localhost:3000
# This backend's own origin — used to build PKCE callback URLs.
AUTH_BACKEND_ORIGIN=http://localhost:8000
# Must be one of AUTH_FRONTEND_ORIGINS. Defaults to it when there's only one.
AUTH_EMAIL_FRONTEND_ORIGIN=

# lax | strict | none. "none" requires HTTPS/Secure (production) cookies.
AUTH_COOKIE_SAMESITE=lax
# Refresh cookie lifetime, in seconds.
AUTH_REFRESH_COOKIE_MAX_AGE=2592000

# A persistent Fernet key for encrypting PKCE/recovery transaction cookies.
# Generate once (see docs/authentication.md); never rotate casually — doing
# so invalidates every pending signup/recovery link.
AUTH_FLOW_ENCRYPTION_KEY=

# Must match aiservice SERVICE_TOKEN. Use stub until a real engine is available.
AI_API_KEY=
AI_ENGINE=stub
# Externally reachable prefix; aiservice appends /runs/{id}/{callback-kind}.
AI_CALLBACK_BASE_URL=http://localhost:8000/internal/v1
# Dedicated persistent Fernet key encrypting immutable job envelopes.
DISPATCH_ENCRYPTION_KEY=
DISPATCH_TIMEOUT_SECONDS=10
DISPATCH_LEASE_SECONDS=180
