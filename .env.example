AI_SERVICE_URL=https://api.example.com
AI_API_KEY=your_api_key_here

# Copy project settings from the EXISTING Supabase project used by BlindSpotFE.
SUPABASE_URL=https://your-existing-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-existing-project-publishable-key
APP_ENV=development
AUTH_FRONTEND_ORIGINS=http://localhost:3000
AUTH_BACKEND_ORIGIN=http://localhost:8000
AUTH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_MAX_AGE=2592000

# Explicit frontend origin for confirmation/recovery links (must be in AUTH_FRONTEND_ORIGINS).
AUTH_EMAIL_FRONTEND_ORIGIN=http://localhost:3000

# Fernet key generated locally; same stable key on all backend workers. Never commit its value.
AUTH_FLOW_ENCRYPTION_KEY=replace-with-a-locally-generated-fernet-key
