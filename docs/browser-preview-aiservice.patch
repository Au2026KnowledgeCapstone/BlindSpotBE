+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+from app.live_browser import serve_live_browser
+from app.live_display import display_commands, display_environment
+
+
+def socket_for(token='Bearer secret', job='job-a', ready=True):
+    runner=SimpleNamespace(config=SimpleNamespace(service_token='secret'),active_job_id=job,live_ready=ready)
+    socket=SimpleNamespace(app=SimpleNamespace(state=SimpleNamespace(runner=runner,live_display=SimpleNamespace(ready=True))),
+        headers={'authorization':token},close=AsyncMock(),accept=AsyncMock(),send_bytes=AsyncMock(),receive_bytes=AsyncMock())
+    return socket,runner
+
+
+def test_v2_display_stays_local_and_enforces_view_only(monkeypatch):
+    commands=display_commands()
+    assert commands[0][:2]==['Xvfb',':99']
+    assert '-viewonly' in commands[1] and '-localhost' in commands[1] and '-nosel' in commands[1]
+    assert commands[2][-2:]==['127.0.0.1:6080','127.0.0.1:5900']
+    monkeypatch.setenv('AI_API_KEY','must-not-reach-browser')
+    monkeypatch.setenv('DISPLAY',':99')
+    assert 'AI_API_KEY' not in display_environment()
+    assert display_environment()['DISPLAY']==':99'
+
+
+async def test_missing_service_auth_never_exposes_display(monkeypatch):
+    ws,_=socket_for(token='secret')
+    upstream=Mock();monkeypatch.setattr('app.live_browser.connect',upstream)
+    await serve_live_browser(ws,'job-a')
+    ws.close.assert_awaited_once_with(code=4401)
+    upstream.assert_not_called()
+
+
+async def test_different_job_and_unready_browser_cannot_view_display(monkeypatch):
+    upstream=Mock();monkeypatch.setattr('app.live_browser.connect',upstream)
+    for job,ready in [('other-job',True),('job-a',False)]:
+        ws,_=socket_for(job=job,ready=ready)
+        await serve_live_browser(ws,'job-a')
+        ws.close.assert_awaited_once_with(code=4409)
+    upstream.assert_not_called()
+
+
+async def test_stream_stops_before_another_jobs_frame(monkeypatch):
+    ws,runner=socket_for()
+    async def receive():
+        await asyncio.Event().wait()
+    ws.receive_bytes.side_effect=receive
+    class Desktop:
+        async def __aenter__(self): return self
+        async def __aexit__(self,*args): pass
+        async def send(self,message): pass
+        async def __aiter__(self):
+            yield b'current-job-frame'
+            runner.active_job_id='other-job'
+            yield b'other-job-frame'
+    monkeypatch.setattr('app.live_browser.connect',lambda *a,**kw:Desktop())
+    await serve_live_browser(ws,'job-a')
+    ws.accept.assert_awaited_once_with(subprotocol='binary')
+    ws.send_bytes.assert_awaited_once_with(b'current-job-frame')
+    ws.close.assert_awaited_once()
