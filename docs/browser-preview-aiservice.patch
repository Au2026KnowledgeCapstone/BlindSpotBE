diff --git a/app/jobs/browser_preview.py b/app/jobs/browser_preview.py
new file mode 100644
index 0000000..d063ab7
--- /dev/null
+++ b/app/jobs/browser_preview.py
@@ -0,0 +1,60 @@
+"""Latest post-login browser frame, private and scoped to one execution job."""
+import asyncio
+import base64
+import hashlib
+import json
+from collections import OrderedDict
+from datetime import datetime, timezone
+from urllib.parse import urlsplit, urlunsplit
+
+
+class BrowserPreviewStore:
+    def __init__(self, config, bucket=None):
+        self.bucket = bucket
+        if self.bucket is None and config.evidence_sink == "gcs" and config.gcs_evidence_bucket:
+            from google.cloud import storage
+            self.bucket = storage.Client().bucket(config.gcs_evidence_bucket)
+        self.frames = OrderedDict()
+
+    @staticmethod
+    def key(job_id):
+        return "browser-preview/" + hashlib.sha256(job_id.encode()).hexdigest() + "/latest.json"
+
+    def _write(self, job_id, frame):
+        if self.bucket is not None:
+            blob = self.bucket.blob(self.key(job_id))
+            blob.cache_control = "private, no-store"
+            blob.upload_from_string(json.dumps(frame), content_type="application/json", timeout=5, retry=None)
+        else:
+            self.frames[job_id] = frame
+            self.frames.move_to_end(job_id)
+            while len(self.frames) > 32:
+                self.frames.popitem(last=False)
+
+    async def publish(self, job_id, page):
+        # Navigation can set page.url before React has rendered anything.
+        state_script = "() => document.readyState === 'complete' && document.body?.innerText.trim() ? location.href + document.body.innerText.slice(0, 10000) : null"
+        before = await page.evaluate(state_script)
+        if before is None:
+            return
+        data = await page.screenshot(type="jpeg", quality=45, full_page=False,
+                                     mask=[page.locator('input[type="password"],input[type="email"]')], timeout=2000)
+        if await page.evaluate(state_script) != before or len(data) > 1_000_000:
+            return
+        parsed = urlsplit(page.url)
+        frame = {"captured_at": datetime.now(timezone.utc).isoformat(),
+                 "page_url": urlunsplit((parsed.scheme, parsed.netloc, parsed.path, "", "")),
+                 "media_type": "image/jpeg", "rendered": True, "source": "live", "image_base64": base64.b64encode(data).decode()}
+        await asyncio.to_thread(self._write, job_id, frame)
+
+    def read(self, job_id):
+        if self.bucket is None:
+            return self.frames.get(job_id)
+        from google.api_core.exceptions import NotFound
+        try:
+            raw = self.bucket.blob(self.key(job_id)).download_as_bytes(timeout=5, retry=None)
+        except NotFound:
+            return None
+        if len(raw) > 1_500_000:
+            raise ValueError("Browser frame exceeds limit")
+        return json.loads(raw)
