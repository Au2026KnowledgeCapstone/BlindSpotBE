index 0000000..81b563d
--- /dev/null
+++ b/app/jobs/evidence_reader.py
@@ -0,0 +1,70 @@
+"""Read only evidence explicitly recorded for the requested execution job."""
+import base64
+import hashlib
+from uuid import UUID
+
+from sqlalchemy import or_, select
+
+from app.jobs.models import OutboxEntry
+from app.operations.errors import OperationError
+
+MAX_BYTES = 10 * 1024 * 1024
+
+
+def read_evidence(sessions, bucket, job_id, evidence_id):
+    try:
+        normalized = UUID(evidence_id).hex
+    except ValueError:
+        raise OperationError("Evidence not found.", 404) from None
+    with sessions() as db:
+        entry = db.scalar(select(OutboxEntry).where(
+            OutboxEntry.job_id == job_id, OutboxEntry.kind == "evidence",
+            or_(OutboxEntry.id == evidence_id, OutboxEntry.payload["storage_key"].as_string().in_([evidence_id, normalized]))))
+        if entry is None:
+            raise OperationError("Evidence not found in this job.", 404)
+        payload = dict(entry.payload)
+    kind = payload.get("kind")
+    media = {"screenshot": "image/png", "page_text": "text/plain; charset=utf-8", "log": "text/plain; charset=utf-8"}.get(kind)
+    if media is None:
+        raise OperationError("Unsupported evidence type.", 415)
+    key = payload.get("storage_key")
+    if key:
+        if bucket is None:
+            raise OperationError("Evidence storage is unavailable.", 503)
+        from google.api_core.exceptions import NotFound
+        try:
+            blob = bucket.blob(key)
+            blob.reload(timeout=5)
+            if blob.size is None or blob.size > MAX_BYTES:
+                raise OperationError("Evidence exceeds size limit.", 413)
+            data = blob.download_as_bytes(timeout=10)
+        except NotFound:
+            raise OperationError("Evidence not found.", 404) from None
+    elif kind == "screenshot":
+        data = base64.b64decode(payload.get("base64", ""), validate=True)
+    else:
+        data = payload.get("text", "").encode()
+    if not data or len(data) > MAX_BYTES:
+        raise OperationError("Invalid evidence size.", 413)
+    digest = hashlib.sha256(data).hexdigest()
+    if payload.get("sha256") and digest != payload["sha256"]:
+        raise OperationError("Evidence integrity check failed.", 502)
+    return {"id": evidence_id, "job_id": job_id, "type": kind, "media_type": media,
+            "content_base64": base64.b64encode(data).decode(), "sha256": digest,
+            "captured_at": payload.get("captured_at")}
+
+
+def latest_screenshot(sessions, bucket, job_id):
+    with sessions() as db:
+        entry = db.scalar(select(OutboxEntry).where(
+            OutboxEntry.job_id == job_id, OutboxEntry.kind == "evidence",
+            OutboxEntry.payload["kind"].as_string() == "screenshot")
+            .order_by(OutboxEntry.payload["captured_at"].as_string().desc()).limit(1))
+        if entry is None:
+            return None
+        identifier = entry.payload.get("storage_key") or entry.id
+    evidence = read_evidence(sessions, bucket, job_id, identifier)
+    if len(evidence["content_base64"]) > 1_400_000 or not evidence.get("captured_at"):
+        return None
+    return {"captured_at": evidence["captured_at"], "page_url": "", "media_type": evidence["media_type"],
+            "image_base64": evidence["content_base64"], "source": "checkpoint"}
diff --git a/app/live_browser.py b/app/live_browser.py
new file mode 100644
index 0000000..12274ce
--- /dev/null
+++ b/app/live_browser.py
@@ -0,0 +1,56 @@
+"""Authenticated RFB relay. The desktop is visible only to its current job."""
+import asyncio
+from secrets import compare_digest
+
+from fastapi import WebSocket
+from starlette.websockets import WebSocketDisconnect
+from websockets.asyncio.client import connect
+from websockets.exceptions import ConnectionClosed
+
+
+async def serve_live_browser(websocket: WebSocket, job_id: str):
+    runner = websocket.app.state.runner
+    authorization = websocket.headers.get('authorization', '')
+    supplied = authorization.removeprefix('Bearer ') if authorization.startswith('Bearer ') else ''
+    if not runner.config.service_token or not compare_digest(supplied.encode(), runner.config.service_token.encode()):
+        await websocket.close(code=4401)
+        return
+    if not websocket.app.state.live_display.ready:
+        await websocket.close(code=4503)
+        return
+    if runner.active_job_id != job_id or not runner.live_ready:
+        await websocket.close(code=4409)
+        return
+    tasks = []
+    try:
+        async with connect('ws://127.0.0.1:6080', subprotocols=['binary'], proxy=None, compression=None, max_size=16_000_000) as desktop:
+            await websocket.accept(subprotocol='binary')
+            async def upstream():
+                while True:
+                    message = await websocket.receive_bytes()
+                    if runner.active_job_id != job_id or not runner.live_ready:
+                        return
+                    await desktop.send(message)
+            async def downstream():
+                async for message in desktop:
+                    if runner.active_job_id != job_id or not runner.live_ready:
+                        return
+                    await websocket.send_bytes(message)
+            async def current_job():
+                while runner.active_job_id == job_id and runner.live_ready and websocket.app.state.live_display.ready:
+                    await asyncio.sleep(0.25)
+            tasks = [asyncio.create_task(f()) for f in (upstream, downstream, current_job)]
+            done, _ = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
+            for task in done:
+                task.result()
+    except (WebSocketDisconnect, ConnectionClosed, OSError, asyncio.CancelledError):
+        pass
+    finally:
+        for task in tasks:
+            task.cancel()
+        if tasks:
+            await asyncio.gather(*tasks, return_exceptions=True)
+        try:
+            await websocket.close()
+        except (RuntimeError, asyncio.CancelledError):
+            pass
