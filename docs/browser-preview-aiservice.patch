+import base64
+import hashlib
+from types import SimpleNamespace
+from uuid import uuid4
+
+import pytest
+
+from app.jobs.evidence_reader import read_evidence
+from app.jobs.models import Job, OutboxEntry
+from app.operations.errors import OperationError
+from tests.test_intake import database
+
+
+def seed(database, payload):
+    key = uuid4().hex
+    with database.begin() as db:
+        db.add(Job(job_id='job-a', run_id='run', status='finished', envelope={}, engine='stub'))
+        db.flush()
+        db.add(OutboxEntry(id=str(uuid4()), job_id='job-a', kind='evidence', payload={'kind':'screenshot','storage_key':key,**payload}))
+    return key
+
+
+def test_gcs_screenshot_is_job_scoped_and_accepts_uuid_format(database):
+    content = b'screenshot-bytes'
+    key = seed(database, {'sha256':hashlib.sha256(content).hexdigest()})
+    blob = SimpleNamespace(size=len(content), reload=lambda **kw: None, download_as_bytes=lambda **kw: content)
+    bucket = SimpleNamespace(blob=lambda value: blob if value == key else None)
+    from uuid import UUID
+    evidence_id = str(UUID(key))
+    result = read_evidence(database, bucket, 'job-a', evidence_id)
+    assert result['id'] == evidence_id
+    assert base64.b64decode(result['content_base64']) == content
+    assert result['media_type'] == 'image/png'
+    with pytest.raises(OperationError) as error:
+        read_evidence(database, bucket, 'other-job', evidence_id)
+    assert error.value.status == 404
+
+
+def test_corrupt_evidence_is_rejected(database):
+    key = seed(database, {'sha256':'0'*64})
+    blob = SimpleNamespace(size=3, reload=lambda **kw: None, download_as_bytes=lambda **kw: b'bad')
+    with pytest.raises(OperationError) as error:
+        read_evidence(database, SimpleNamespace(blob=lambda key:blob), 'job-a', key)
+    assert error.value.status == 502
+
+
+def test_old_run_can_fall_back_to_its_recorded_screenshot(database):
+    from app.jobs.evidence_reader import latest_screenshot
+    content=b'checkpoint'
+    key=seed(database,{'captured_at':'2026-11-19T18:00:00+00:00'})
+    blob=SimpleNamespace(size=len(content),reload=lambda **kw:None,download_as_bytes=lambda **kw:content)
+    frame=latest_screenshot(database,SimpleNamespace(blob=lambda key:blob),'job-a')
+    assert frame['source']=='checkpoint'
+    assert frame['media_type']=='image/png'
+    assert base64.b64decode(frame['image_base64'])==content
+    assert latest_screenshot(database,None,'other-job') is None
