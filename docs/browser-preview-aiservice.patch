+import asyncio
+import base64
+from types import SimpleNamespace
+
+import pytest
+
+from app.jobs.browser_preview import BrowserPreviewStore
+from engines.mvp.browser import MvpSession
+
+
+class Page:
+    url = "https://target.test/dashboard?token=hidden#private"
+    def locator(self, value):
+        assert value == 'input[type="password"],input[type="email"]'
+        return "password-fields"
+    async def evaluate(self, script):
+        return "stable visible page"
+    async def screenshot(self, **kwargs):
+        assert kwargs['mask'] == ['password-fields']
+        assert kwargs['full_page'] is False
+        return b'jpeg'
+
+
+async def test_frame_masks_passwords_and_omits_url_secrets():
+    store = BrowserPreviewStore(SimpleNamespace(evidence_sink='outbox'))
+    await store.publish('job-a', Page())
+    frame = store.read('job-a')
+    assert frame['page_url'] == 'https://target.test/dashboard'
+    assert base64.b64decode(frame['image_base64']) == b'jpeg'
+    assert store.read('job-b') is None
+
+
+async def test_memory_frames_are_bounded():
+    store = BrowserPreviewStore(SimpleNamespace(evidence_sink='outbox'))
+    for n in range(34):
+        await store.publish(str(n), Page())
+    assert len(store.frames) == 32
+    assert store.read('0') is None
+
+
+async def test_private_bucket_frame_shared_between_instances():
+    objects = {}
+    class Blob:
+        def __init__(self, key): self.key = key
+        def upload_from_string(self, data, **kwargs): objects[self.key] = data.encode()
+        def download_as_bytes(self, **kwargs): return objects[self.key]
+    bucket = SimpleNamespace(blob=Blob)
+    config = SimpleNamespace(evidence_sink='outbox')
+    writer, reader = BrowserPreviewStore(config, bucket), BrowserPreviewStore(config, bucket)
+    await writer.publish('job', Page())
+    assert reader.read('job')['media_type'] == 'image/jpeg'
+    assert 'browser-preview/' in next(iter(objects))
+
+
+async def test_capture_failure_does_not_fail_browser_session():
+    class PreviewPage:
+        url = 'https://target.test/'
+        def is_closed(self): return False
+    browser = SimpleNamespace()
+    session = MvpSession(None, browser, None, None, SimpleNamespace(url='https://target.test', viewport_width=800, viewport_height=600))
+    called = asyncio.Event()
+    async def broken(page):
+        called.set()
+        raise RuntimeError('storage temporarily unavailable')
+    session.set_preview(broken)
+    task = asyncio.create_task(session._preview(PreviewPage()))
+    await asyncio.wait_for(called.wait(), 1)
+    await asyncio.sleep(0)
+    assert not task.done()
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError): await task
+
+
+async def test_endpoint_requires_token_and_checks_job_binding(database):
+    import httpx
+    from app.main import create_app
+    from app.jobs.models import Job
+    from tests.test_intake import config, HEADERS
+    app = create_app(config(), database, start_delivery=False)
+    with database.begin() as db:
+        db.add(Job(job_id='preview-job', run_id='run', status='running', envelope={}, engine='stub'))
+    async with app.router.lifespan_context(app):
+        await app.state.runner.browser_preview.publish('preview-job', Page())
+        async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url='http://test') as client:
+            path = '/v1/jobs/preview-job/browser-preview'
+            assert (await client.get(path)).status_code == 401
+            response = await client.get(path, headers=HEADERS)
+            assert response.status_code == 200
+            assert response.json()['job_id'] == 'preview-job'
+            assert response.json()['frame']['page_url'] == 'https://target.test/dashboard'
+            assert response.headers['Cache-Control'] == 'private, no-store'
+            assert (await client.get('/v1/jobs/missing/browser-preview', headers=HEADERS)).status_code == 404
+
+
+from tests.test_intake import database  # shared isolated SQLite fixture
+
+
+async def test_real_browser_captures_frame_and_stops_on_close(local_page):
+    from engines.base import Credentials, Target
+    from engines.mvp.browser import open_session
+    store = BrowserPreviewStore(SimpleNamespace(evidence_sink='outbox'))
+    session = await open_session(Target(local_page, 800, 600), Credentials({}))
+    assert session.preview_callback is None  # prepare/login is never streamed
+    session.set_preview(lambda page: store.publish('real-browser', page))
+    try:
+        context, page = await session.open_context()
+        await session.open_landing(page)
+        async with asyncio.timeout(8):
+            while store.read('real-browser') is None:
+                await asyncio.sleep(0.1)
+        frame = store.read('real-browser')
+        assert base64.b64decode(frame['image_base64']).startswith(b'\xff\xd8')
+        await context.close()
+    finally:
+        await session.close()
+    assert not session.preview_tasks
+
+
+from tests.test_mvp_engine import local_page
+
+
+async def test_blank_and_transition_frames_do_not_replace_visible_frame():
+    store = BrowserPreviewStore(SimpleNamespace(evidence_sink='outbox'))
+    await store.publish('job', Page())
+    original = store.read('job')
+    class Blank(Page):
+        async def evaluate(self, script): return None
+        async def screenshot(self, **kwargs): raise AssertionError('Blank page captured')
+    await store.publish('job', Blank())
+    assert store.read('job') is original
+    class Transition(Page):
+        calls = 0
+        async def evaluate(self, script):
+            self.calls += 1
+            return 'before' if self.calls == 1 else 'after'
+    await store.publish('job', Transition())
+    assert store.read('job') is original
