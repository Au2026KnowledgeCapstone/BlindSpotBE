+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+from engines.base import Credentials, Target
+from engines.mvp.browser import open_session
+
+
+@pytest.fixture
+def login_site():
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args): pass
+        def do_GET(self):
+            self.send_response(200); self.send_header('Content-Type', 'text/html'); self.end_headers()
+            if self.path == '/dashboard':
+                html = '''<h1>Dashboard</h1><p id="session">Checking session</p><script>
+                const req=indexedDB.open('auth',1);req.onsuccess=()=>{
+                  const tx=req.result.transaction('users');const q=tx.objectStore('users').get('current');
+                  q.onsuccess=()=>document.querySelector('#session').textContent=q.result==='doctor'?'Session restored':'No session';
+                };</script>'''
+            else:
+                html = '''<form><input type="email"><input type="password"><button type="submit">Sign in</button></form><script>
+                document.querySelector('form').onsubmit=e=>{e.preventDefault();const req=indexedDB.open('auth',1);
+                req.onupgradeneeded=()=>req.result.createObjectStore('users');req.onsuccess=()=>{
+                const tx=req.result.transaction('users','readwrite');tx.objectStore('users').put('doctor','current');
+                tx.oncomplete=()=>location.href='/dashboard';};};</script>'''
+            self.wfile.write(html.encode())
+    server=ThreadingHTTPServer(('127.0.0.1',0),Handler)
+    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()
+    yield f'http://127.0.0.1:{server.server_port}/login'
+    server.shutdown();thread.join();server.server_close()
+
+
+async def test_new_test_context_reuses_authenticated_url_and_indexeddb(login_site):
+    session=await open_session(Target(login_site,800,600),Credentials({'username':'doctor@example.test','password':'test','success_selector':'h1'}))
+    try:
+        assert session.target_url.endswith('/dashboard')
+        context,page=await session.open_context()
+        await session.open_landing(page)
+        await page.get_by_text('Session restored',exact=True).wait_for()
+        assert await page.locator('input[type=password]').count()==0
+        await context.close()
+    finally:
+        await session.close()
